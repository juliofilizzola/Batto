<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>batto</AssemblyName>
    <RootNamespace>Batto.Linux</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.0.4</Version>
    <!-- Tray app with tiny allocations: background GC threads and their reserved memory cost more than they save -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- All formats are explicit (HH:mm:ss, hex), so ICU is not needed; skipping it avoids loading libicu -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\batto.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Batto.Core\Batto.Core.csproj" />
  </ItemGroup>

</Project>
