<Window x:Class="Batto.Tray.DeviceFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tray="clr-namespace:Batto.Tray"
        xmlns:models="clr-namespace:Batto.Models"
        Title="Batto"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Width="320"
        FontFamily="Segoe UI">
    <Border Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="10" Padding="8">
        <StackPanel>
            <TextBlock x:Name="EmptyText"
                       Text="Nenhum dispositivo encontrado"
                       FontSize="12" Foreground="#9CA3AF" Margin="8,6" Visibility="Collapsed"/>
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BluetoothDeviceModel}">
                        <Grid Margin="4,4">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrayVisible, Mode=OneWay}" Value="False">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                                <tray:BatteryRing Percent="{Binding BatteryLevel, TargetNullValue=-1, Mode=OneWay}"
                                                  IsConnected="{Binding IsConnected, Mode=OneWay}"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding TypeGlyph, Mode=OneWay}"/>
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#9CA3AF">
                                    <Run Text="{Binding StatusDescription, Mode=OneWay}"/>
                                    <Run Text="{Binding TrayStatusText, Mode=OneWay}" Foreground="#60A5FA"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding BatteryText, Mode=OneWay}" FontSize="15"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding BatteryColorHex, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
