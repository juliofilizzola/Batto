<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/batto.ico</ApplicationIcon>
    <Version>0.0.8</Version>
    <!-- Tray app with tiny allocations: background GC threads and their reserved memory cost more than they save -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/batto.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Batto.Core\Batto.Core.csproj" />
  </ItemGroup>

</Project>
